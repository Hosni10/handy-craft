// Handy Craft Prisma Schema
// Full schema for all domain entities as specified in the product brief.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ──────────────────────────────────────────────────────────────────

enum UserRole {
  BUYER
  SELLER
  ADMIN
}

enum BadgeStatus {
  unverified
  pending
  verified
  rejected
}

enum ProductStatus {
  draft
  pending
  active
  rejected
}

enum OrderStatus {
  new
  confirmed
  preparing
  shipped
  delivered
  cancelled
  refused
}

enum PaymentMethod {
  cod
  electronic
}

enum PaymentStatus {
  pending
  paid
  failed
  refunded
}

enum DisputeStatus {
  open
  under_review
  resolved_buyer
  resolved_seller
}

enum WithdrawalMethod {
  instapay
  vodafone_cash
  bank
}

enum WithdrawalStatus {
  pending
  paid
  rejected
}

enum WalletTransactionType {
  credit
  debit
}

enum CustomOrderStatus {
  pending
  quoted
  accepted
  rejected
  completed
}

enum StoreVerificationStatus {
  pending
  approved
  rejected
}

// ─── Users ──────────────────────────────────────────────────────────────────

model User {
  id          String   @id @default(uuid())
  phone       String   @unique
  name        String
  email       String?
  role        UserRole @default(BUYER)
  governorate String?
  avatar      String?
  createdAt   DateTime @default(now()) @map("created_at")

  // Relations
  store                 Store?
  orders                Order[]              @relation("BuyerOrders")
  reviews               Review[]
  disputes              Dispute[]            @relation("DisputeOpener")
  customOrderRequests   CustomOrderRequest[] @relation("BuyerCustomOrders")
  wallet                Wallet?
  withdrawals           Withdrawal[]
  notifications         Notification[]
  otpCodes              OtpCode[]
  resolvedDisputes      Dispute[]            @relation("DisputeResolver")
  disputeMessages       DisputeMessage[]
  processedWithdrawals  Withdrawal[]         @relation("WithdrawalProcessor")
  reviewedVerifications StoreVerification[]  @relation("VerificationReviewer")

  @@map("users")
}

// ─── OTP ────────────────────────────────────────────────────────────────────

model OtpCode {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  code      String
  expiresAt DateTime @map("expires_at")
  used      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([code])
  @@map("otp_codes")
}

// ─── Stores ─────────────────────────────────────────────────────────────────

model Store {
  id            String      @id @default(uuid())
  ownerId       String      @unique @map("owner_id")
  name          String
  slug          String      @unique
  bio           String?
  logo          String?
  governorate   String?
  badgeStatus   BadgeStatus @default(unverified) @map("badge_status")
  shippingZones String[]    @map("shipping_zones")
  ratingAvg     Float       @default(0) @map("rating_avg")
  ratingCount   Int         @default(0) @map("rating_count")
  createdAt     DateTime    @default(now()) @map("created_at")

  owner         User                @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  products      Product[]
  orders        Order[]             @relation("StoreOrders")
  verifications StoreVerification[]
  reviews       Review[]

  @@index([slug])
  @@index([badgeStatus])
  @@map("stores")
}

// ─── Store Verifications ─────────────────────────────────────────────────────

model StoreVerification {
  id         String                  @id @default(uuid())
  storeId    String                  @map("store_id")
  mediaUrls  String[]                @map("media_urls")
  note       String?
  reviewNote String?                 @map("review_note")
  reviewedBy String?                 @map("reviewed_by")
  reviewedAt DateTime?               @map("reviewed_at")
  status     StoreVerificationStatus @default(pending)
  createdAt  DateTime                @default(now()) @map("created_at")

  store    Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  reviewer User? @relation("VerificationReviewer", fields: [reviewedBy], references: [id])

  @@index([storeId])
  @@index([status])
  @@map("store_verifications")
}

// ─── Categories ─────────────────────────────────────────────────────────────

model Category {
  id       String  @id @default(uuid())
  nameAr   String  @map("name_ar")
  parentId String? @map("parent_id")
  image    String?

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  products Product[]

  @@index([parentId])
  @@map("categories")
}

// ─── Products ───────────────────────────────────────────────────────────────

model Product {
  id              String        @id @default(uuid())
  storeId         String        @map("store_id")
  categoryId      String        @map("category_id")
  name            String
  description     String
  materials       String?
  priceEgp        Decimal       @map("price_egp") @db.Decimal(12, 2)
  stockQty        Int           @default(0) @map("stock_qty")
  madeToOrder     Boolean       @default(false) @map("made_to_order")
  productionDays  Int?          @map("production_days")
  images          String[]
  videoUrl        String?       @map("video_url")
  status          ProductStatus @default(draft)
  rejectionReason String?       @map("rejection_reason")
  featured        Boolean       @default(false)
  createdAt       DateTime      @default(now()) @map("created_at")

  store           Store                  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  category        Category               @relation(fields: [categoryId], references: [id])
  customizations  ProductCustomization[]
  orderItems      OrderItem[]
  customOrderReqs CustomOrderRequest[]

  @@index([storeId])
  @@index([categoryId])
  @@index([status])
  @@index([featured])
  @@index([createdAt])
  @@map("products")
}

// ─── Product Customizations ──────────────────────────────────────────────────

model ProductCustomization {
  id         String   @id @default(uuid())
  productId  String   @map("product_id")
  optionName String   @map("option_name")
  choices    String[]
  priceDelta Decimal  @default(0) @map("price_delta") @db.Decimal(12, 2)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_customizations")
}

// ─── Custom Order Requests ───────────────────────────────────────────────────

model CustomOrderRequest {
  id          String            @id @default(uuid())
  buyerId     String            @map("buyer_id")
  productId   String            @map("product_id")
  details     String
  quotedPrice Decimal?          @map("quoted_price") @db.Decimal(12, 2)
  quotedDays  Int?              @map("quoted_days")
  sellerNote  String?           @map("seller_note")
  depositPct  Int               @default(30) @map("deposit_pct")
  depositPaid Boolean           @default(false) @map("deposit_paid")
  status      CustomOrderStatus @default(pending)
  createdAt   DateTime          @default(now()) @map("created_at")

  buyer   User    @relation("BuyerCustomOrders", fields: [buyerId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@index([buyerId])
  @@index([productId])
  @@map("custom_order_requests")
}

// ─── Orders ─────────────────────────────────────────────────────────────────

model Order {
  id              String        @id @default(uuid())
  buyerId         String        @map("buyer_id")
  storeId         String        @map("store_id")
  status          OrderStatus   @default(new)
  paymentMethod   PaymentMethod @map("payment_method")
  paymentStatus   PaymentStatus @default(pending) @map("payment_status")
  subtotalEgp     Decimal       @map("subtotal_egp") @db.Decimal(12, 2)
  shippingFeeEgp  Decimal       @default(0) @map("shipping_fee_egp") @db.Decimal(12, 2)
  commissionEgp   Decimal       @default(0) @map("commission_egp") @db.Decimal(12, 2)
  totalEgp        Decimal       @map("total_egp") @db.Decimal(12, 2)
  addressSnapshot Json          @map("address_snapshot")
  notes           String?
  deliveredAt     DateTime?     @map("delivered_at")
  createdAt       DateTime      @default(now()) @map("created_at")

  buyer    User        @relation("BuyerOrders", fields: [buyerId], references: [id])
  store    Store       @relation("StoreOrders", fields: [storeId], references: [id])
  items    OrderItem[]
  shipment Shipment?
  review   Review?
  dispute  Dispute?
  codOtp   CodOtp?

  @@index([buyerId])
  @@index([storeId])
  @@index([status])
  @@index([createdAt])
  @@map("orders")
}

// ─── Order Items ─────────────────────────────────────────────────────────────

model OrderItem {
  id                    String  @id @default(uuid())
  orderId               String  @map("order_id")
  productId             String  @map("product_id")
  qty                   Int
  unitPrice             Decimal @map("unit_price") @db.Decimal(12, 2)
  customizationSnapshot Json?   @map("customization_snapshot")

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@map("order_items")
}

// ─── COD OTP ─────────────────────────────────────────────────────────────────

model CodOtp {
  id        String   @id @default(uuid())
  orderId   String   @unique @map("order_id")
  code      String
  expiresAt DateTime @map("expires_at")
  confirmed Boolean  @default(false)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("cod_otps")
}

// ─── Shipments ───────────────────────────────────────────────────────────────

model Shipment {
  id             String   @id @default(uuid())
  orderId        String   @unique @map("order_id")
  courier        String   @default("bosta")
  trackingNumber String?  @map("tracking_number")
  status         String   @default("pending")
  codAmount      Decimal  @default(0) @map("cod_amount") @db.Decimal(12, 2)
  courierPayload Json     @default("{}") @map("courier_payload")
  createdAt      DateTime @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([trackingNumber])
  @@map("shipments")
}

// ─── Wallets ─────────────────────────────────────────────────────────────────

model Wallet {
  id         String   @id @default(uuid())
  userId     String   @unique @map("user_id")
  balanceEgp Decimal  @default(0) @map("balance_egp") @db.Decimal(12, 2)
  updatedAt  DateTime @updatedAt @map("updated_at")

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]

  @@map("wallets")
}

model WalletTransaction {
  id        String                @id @default(uuid())
  walletId  String                @map("wallet_id")
  type      WalletTransactionType
  amount    Decimal               @db.Decimal(12, 2)
  refType   String?               @map("ref_type")
  refId     String?               @map("ref_id")
  note      String?
  createdAt DateTime              @default(now()) @map("created_at")

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId])
  @@map("wallet_transactions")
}

// ─── Withdrawals ─────────────────────────────────────────────────────────────

model Withdrawal {
  id          String           @id @default(uuid())
  sellerId    String           @map("seller_id")
  amount      Decimal          @db.Decimal(12, 2)
  method      WithdrawalMethod
  destination String
  status      WithdrawalStatus @default(pending)
  adminNote   String?          @map("admin_note")
  processedBy String?          @map("processed_by")
  processedAt DateTime?        @map("processed_at")
  createdAt   DateTime         @default(now()) @map("created_at")

  seller    User  @relation(fields: [sellerId], references: [id])
  processor User? @relation("WithdrawalProcessor", fields: [processedBy], references: [id])

  @@index([sellerId])
  @@index([status])
  @@map("withdrawals")
}

// ─── Reviews ─────────────────────────────────────────────────────────────────

model Review {
  id        String   @id @default(uuid())
  orderId   String   @unique @map("order_id")
  storeId   String   @map("store_id")
  buyerId   String   @map("buyer_id")
  rating    Int
  comment   String?
  images    String[]
  createdAt DateTime @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id])
  store Store @relation(fields: [storeId], references: [id])
  buyer User  @relation(fields: [buyerId], references: [id])

  @@index([storeId])
  @@map("reviews")
}

// ─── Disputes ────────────────────────────────────────────────────────────────

model Dispute {
  id             String        @id @default(uuid())
  orderId        String        @unique @map("order_id")
  openedBy       String        @map("opened_by")
  reason         String
  evidence       String[]
  status         DisputeStatus @default(open)
  resolutionNote String?       @map("resolution_note")
  resolvedBy     String?       @map("resolved_by")
  resolvedAt     DateTime?     @map("resolved_at")
  createdAt      DateTime      @default(now()) @map("created_at")

  order    Order            @relation(fields: [orderId], references: [id])
  opener   User             @relation("DisputeOpener", fields: [openedBy], references: [id])
  resolver User?            @relation("DisputeResolver", fields: [resolvedBy], references: [id])
  messages DisputeMessage[]

  @@index([status])
  @@map("disputes")
}

model DisputeMessage {
  id        String   @id @default(uuid())
  disputeId String   @map("dispute_id")
  authorId  String   @map("author_id")
  body      String
  images    String[]
  createdAt DateTime @default(now()) @map("created_at")

  dispute Dispute @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  author  User    @relation(fields: [authorId], references: [id])

  @@index([disputeId])
  @@map("dispute_messages")
}

// ─── Banners ─────────────────────────────────────────────────────────────────

model Banner {
  id       String  @id @default(uuid())
  title    String
  image    String
  link     String?
  position Int     @default(0)
  active   Boolean @default(true)

  @@index([active, position])
  @@map("banners")
}

// ─── Notifications ───────────────────────────────────────────────────────────

model Notification {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  title     String
  body      String
  type      String
  read      Boolean  @default(false)
  refUrl    String?  @map("ref_url")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@map("notifications")
}
