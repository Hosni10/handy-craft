# ──────────────────────────────────────────────────────────────
# CraftSouq Environment Variables
# Copy this file to .env and fill in the values for your environment.
# ──────────────────────────────────────────────────────────────

# ── Database ───────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:password@localhost:5432/craftsouq"

# ── Auth ───────────────────────────────────────────────────────
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="change-me-to-a-long-random-string"

# ── Server ─────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# ── Business Rules ─────────────────────────────────────────────
# Platform commission percentage taken from each order (default: 10)
COMMISSION_PCT=10

# OTP expiry in seconds (default: 300 = 5 minutes)
OTP_EXPIRY_SECONDS=300

# COD delivery confirmation OTP expiry in seconds (default: 3600 = 1 hour)
COD_OTP_EXPIRY_SECONDS=3600

# ── Payment Gateway (Paymob) ───────────────────────────────────
# Obtain from https://accept.paymob.com → Settings → API Keys
PAYMOB_API_KEY=

# ── Courier (Bosta) ────────────────────────────────────────────
# Obtain from https://app.bosta.co → Settings → API
BOSTA_API_KEY=

# ── File Storage ───────────────────────────────────────────────
# Local uploads directory (relative to apps/api root)
UPLOAD_DIR=uploads
# Future S3 settings (leave blank for local storage)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=me-south-1
# S3_BUCKET=craftsouq-uploads
